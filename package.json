  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-timeout": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-web": "^0.1.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.10.0"
